{
  "namespace": "com.geolite.scenarios.event",
  "type": "record",
  "name": "ScenarioCreatedEvent",
  "fields": [
    {
      "name": "eventId",
      "type": "string"  // Changed from logicalType "uuid"
    },
    {
      "name": "timestamp",
      "type": "long"
    },
    {
      "name": "scenarioId",
      "type": "string"  // Changed from logicalType "uuid"
    },
    {
      "name": "projectId",
      "type": "string"  // Changed from logicalType "uuid"
    },
    {
      "name": "scenarioName",
      "type": "string"
    },
    {
      "name": "target",
      "type": "string"
    },
    {
      "name": "methods",
      "type": "string"
    },
    {
      "name": "budget",
      "type": "bytes",
      "precision": 10,
      "scale": 2
    },
    {
      "name": "createdBy",
      "type": "string"
    },
    {
      "name": "createdDate",
      "type": "long"
    }
  ]
}
